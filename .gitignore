module/items_em089.inc
module/gear_em089.inc
module/gear_weapons_em089.inc
module/notes_em089.inc
# emulator data dir of tools/ryutest.sh (holds prod.keys / title.keys and a save copy)
ryuroot/
save-backup-*/
