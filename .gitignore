# Game data and anything derived from it stays out of git (ported assets stay local, never in a public repo).
# Rebuild them with the tools/ converters from your own 4U / GU dumps.
dump/
monsters/*/romfs/
monsters/*/romfs-*/
# generated tables holding 4U text / records (monsters/<name>/tools/*.py -> monsters/<name>/gen/)
monsters/*/gen/
# emulator data dir of tools/ryutest.sh (holds prod.keys / title.keys and a save copy)
ryuroot/
save-backup-*/
# build output, caches
module/out/
installer/target/
installer/dist/
__pycache__/
*.pyc
.venv/
.claude/
